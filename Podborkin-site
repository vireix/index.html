],

игры:[
{name:"FIFA",price:5000,delivery:2,img:img("football game")},
{name:"Call of Duty",price:6000,delivery:3,img:img("war game")},
{name:"GTA",price:4000,delivery:2,img:img("gta game")},
{name:"Cyberpunk",price:5500,delivery:3,img:img("cyberpunk game")},
{name:"Minecraft",price:3000,delivery:1,img:img("minecraft")},
{name:"Fortnite",price:2500,delivery:1,img:img("fortnite")}
],

книги:[
{name:"Harry Potter",price:2000,delivery:2,img:img("harry potter book")},
{name:"1984",price:1500,delivery:2,img:img("1984 book")},
{name:"Dune",price:2200,delivery:3,img:img("dune book")},
{name:"LOTR",price:3000,delivery:4,img:img("lord of the rings book")},
{name:"Rich Dad",price:1800,delivery:2,img:img("business book")},
{name:"Atlas",price:2500,delivery:3,img:img("book")}
],

аксессуары:[
{name:"Phone Case",price:3000,delivery:2,img:img("phone case")},
{name:"Watch Strap",price:2000,delivery:3,img:img("watch strap")},
{name:"Laptop Sleeve",price:2500,delivery:3,img:img("laptop sleeve")},
{name:"Phone Stand",price:1500,delivery:2,img:img("phone stand")},
{name:"Cable Organizer",price:1200,delivery:2,img:img("cable organizer")},
{name:"Wireless Charger",price:3500,delivery:3,img:img("wireless charger")}
]

};

let current="телефоны";

const pDiv=document.getElementById("products");
const cats=document.getElementById("cats");

Object.keys(data).forEach(c=>{
let b=document.createElement("button");
b.innerText=c;
b.onclick=()=>{
current=c;
render();
document.querySelectorAll(".categories button").forEach(x=>x.classList.remove("active"));
b.classList.add("active");
};
cats.appendChild(b);
});
cats.children[0].classList.add("active");

function render(){
pDiv.innerHTML="";
data[current]
.filter(i=>i.price<=price.value && i.delivery<=delivery.value)
.forEach(i=>{
pDiv.innerHTML+=`
<div class="card">
<img src="${i.img}">
<div>${i.name}</div>
<div class="price">${i.price} ₽</div>
<div>${i.delivery} дней</div>
<button onclick="add()">В корзину</button>
</div>`;
});
}

function add(){
cart++;
document.getElementById("cartCount").innerText=cart;
}

function openCart(){
alert("В корзине товаров: "+cart);
}

search.oninput=e=>{
if(data[e.target.value]){current=e.target.value;render();}
};

price.oninput=()=>{priceVal.innerText=price.value;render();}
delivery.oninput=()=>{deliveryVal.innerText=delivery.value;render();}

render();
</script>

</body>
</html>

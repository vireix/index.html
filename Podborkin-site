<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<title>ПОДБОРКИН</title>
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<style>
:root { --main:#6c5ce7; --bg:#f5f6fa; }
body {margin:0;font-family:-apple-system;background:var(--bg);}

header {
  background:#fff;
  padding:15px;
  display:flex;
  flex-wrap:wrap;
  justify-content:space-between;
  align-items:center;
  gap:10px;
  box-shadow:0 2px 10px rgba(0,0,0,.05);
}

.logo {display:flex;align-items:center;gap:15px;}

.cart {
  background:#fff;
  padding:6px 12px;
  border-radius:20px;
  cursor:pointer;
  box-shadow:0 2px 6px rgba(0,0,0,.1);
}

.searchBox {position:relative;flex:1;max-width:400px;}

.searchBox input {
  width:100%;
  padding:10px 10px 10px 35px;
  border-radius:10px;
  border:1px solid #ddd;
}

.icon {
  position:absolute;
  left:10px;
  top:50%;
  transform:translateY(-50%);
}

.categories {
  display:flex;
  flex-wrap:wrap;
  gap:8px;
  padding:10px;
}

.categories button {
  padding:8px 12px;
  border:none;
  border-radius:20px;
  cursor:pointer;
  background:#fff;
}

.categories .active {background:var(--main);color:#fff;}

.container {display:flex;}

.sidebar {width:230px;padding:15px;}

.box {
  background:#fff;
  padding:15px;
  border-radius:12px;
  margin-bottom:10px;
}

.content {flex:1;padding:15px;}

.grid {
  display:grid;
  grid-template-columns:repeat(auto-fill,minmax(180px,1fr));
  gap:12px;
}

.card {
  background:#fff;
  padding:10px;
  border-radius:12px;
  box-shadow:0 5px 15px rgba(0,0,0,.05);
  transition:.2s;
}

.card:hover {transform:translateY(-5px);}

.card img {
  width:100%;
  height:140px;
  object-fit:cover;
  border-radius:8px;
}

.price {font-weight:bold;}

.card button {
  margin-top:5px;
  width:100%;
  padding:6px;
  border:none;
  border-radius:8px;
  background:var(--main);
  color:#fff;
  cursor:pointer;
}

@media(max-width:768px){
.container{flex-direction:column}
.sidebar{width:100%}
}
</style>
</head>

<body>

<header>
  <div class="logo">
    <h1>ПОДБОРКИН</h1>
    <div class="cart" onclick="openCart()">🛒 <span id="cartCount">0</span></div>
  </div>

  <div class="searchBox">
    <span class="icon">🔍</span>
    <input id="search" placeholder="Введите категорию">
  </div>
</header>

<div id="cats" class="categories"></div>

<div class="container">

<div class="sidebar">
<div class="box">
Цена до: <b id="priceVal">200000</b><br>
<input type="range" id="price" min="1000" max="200000" value="200000">
</div>

<div class="box">
Доставка до: <b id="deliveryVal">10</b><br>
<input type="range" id="delivery" min="1" max="10" value="10">
</div>
</div>

<div class="content">
<div id="products" class="grid"></div>
</div>

</div>

<script>
let cart=0;

// 🔥 Google-friendly картинки
const img = (q) => `https://source.unsplash.com/400x400/?${q}`;

const data = {

телефоны:[
{name:"iPhone 15 Pro",price:120000,delivery:2,img:img("iphone")},
{name:"Samsung Galaxy",price:95000,delivery:3,img:img("samsung phone")},
{name:"Google Pixel",price:85000,delivery:4,img:img("pixel phone")},
{name:"Xiaomi",price:70000,delivery:4,img:img("xiaomi phone")},
{name:"OnePlus",price:75000,delivery:5,img:img("oneplus phone")},
{name:"Huawei",price:80000,delivery:5,img:img("huawei phone")}
],

ноутбуки:[
{name:"MacBook",price:130000,delivery:2,img:img("macbook")},
{name:"Dell Laptop",price:115000,delivery:3,img:img("dell laptop")},
{name:"ThinkPad",price:140000,delivery:4,img:img("thinkpad")},
{name:"ASUS Gaming",price:150000,delivery:5,img:img("gaming laptop")},
{name:"HP Laptop",price:125000,delivery:4,img:img("hp laptop")},
{name:"Acer Laptop",price:80000,delivery:5,img:img("acer laptop")}
],

наушники:[
{name:"AirPods",price:25000,delivery:2,img:img("airpods")},
{name:"Sony Headphones",price:35000,delivery:3,img:img("sony headphones")},
{name:"Bose",price:32000,delivery:4,img:img("bose headphones")},
{name:"JBL",price:12000,delivery:5,img:img("jbl headphones")},
{name:"Beats",price:27000,delivery:4,img:img("beats headphones")},
{name:"Sennheiser",price:30000,delivery:4,img:img("sennheiser headphones")}
],

кроссовки:[
{name:"Nike Air",price:12000,delivery:3,img:img("nike sneakers")},
{name:"Adidas",price:15000,delivery:4,img:img("adidas sneakers")},
{name:"New Balance",price:11000,delivery:5,img:img("new balance sneakers")},
{name:"Puma",price:10000,delivery:4,img:img("puma sneakers")},
{name:"Nike Max",price:14000,delivery:3,img:img("nike air max")},
{name:"Reebok",price:9000,delivery:5,img:img("reebok sneakers")}
],

одежда:[
{name:"Hoodie",price:8000,delivery:3,img:img("hoodie")},
{name:"T-Shirt",price:4000,delivery:2,img:img("t shirt")},
{name:"Jeans",price:9000,delivery:4,img:img("jeans")},
{name:"Jacket",price:12000,delivery:5,img:img("jacket")},
{name:"Coat",price:15000,delivery:4,img:img("coat")},
{name:"Sweater",price:6000,delivery:3,img:img("sweater")}
],

рюкзаки:[
{name:"Backpack",price:7000,delivery:3,img:img("backpack")},
{name:"Nike Backpack",price:5000,delivery:2,img:img("nike backpack")},
{name:"Adidas Bag",price:4500,delivery:3,img:img("adidas bag")},
{name:"Travel Bag",price:12000,delivery:5,img:img("travel bag")},
{name:"Urban Backpack",price:4000,delivery:4,img:img("urban backpack")},
{name:"Puma Backpack",price:4800,delivery:3,img:img("puma backpack")}
],

очки:[
